# Скопируйте файл в .env и заполните значения

# Ключ ProxyAPI (OpenAI-совместимый API) — для генерации техкарт
PROXYAPI_KEY=
PROXYAPI_BASE_URL=https://api.proxyapi.ru/openai/v1

# Таблица со стоимостью материалов (Google Sheets)
MATERIALS_PRICE_SHEET=https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit?gid=<GID>

# Ширина рулона ткани по умолчанию, м
FABRIC_WIDTH=1.5
